PORT=5000
# MongoDB Atlas connection string (replace user, password, cluster and db name)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/expense_review?retryWrites=true&w=majority
# Secret used to sign login tokens. At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Optional: without a key the app falls back to a deterministic rules-based classifier
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000
